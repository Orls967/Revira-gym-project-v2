{
  "info": {
    "name": "Revira Gym API - Auth",
    "description": "Login dan logout Bearer token. Ganti variabel `baseUrl` ke URL lokal atau staging. Setelah Login dijalankan, token otomatis tersimpan di variabel `token` dan dipakai request lain. Request Admin ping / Member ping membuktikan middleware role (SCRUM-40): login sebagai admin atau member lewat variabel `email`. Register (SCRUM-92) membuat akun member baru dan otomatis menyimpan token; Me hanya untuk role member.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000/api/v1" },
    { "key": "email", "value": "member1@revira.test" },
    { "key": "adminEmail", "value": "admin@revira.test" },
    { "key": "password", "value": "" },
    { "key": "token", "value": "" },
    { "key": "id", "value": "1" }
  ],  
  "item": [
    {
      "name": "Login (mobile)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "if (body.data && body.data.token) {",
              "  pm.collectionVariables.set('token', body.data.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"mobile\"\n}"
        },
        "url": "{{baseUrl}}/login"
      },
      "response": [
        {
          "name": "200 Login berhasil",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "_postman_previewlanguage": "json",
          "body": "{\n  \"message\": \"Login berhasil\",\n  \"data\": {\n    \"token\": \"1|AbCdEfGhIjKlMnOpQrStUvWxYz0123456789abcd\",\n    \"token_type\": \"Bearer\",\n    \"user\": {\n      \"id\": 1,\n      \"name\": \"Member Contoh\",\n      \"email\": \"member1@revira.test\",\n      \"role\": \"member\"\n    }\n  }\n}"
        },
        {
          "name": "401 Email atau password salah",
          "status": "Unauthorized",
          "code": 401,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "_postman_previewlanguage": "json",
          "body": "{\n  \"message\": \"Email atau password salah.\"\n}"
        },
        {
          "name": "422 Validasi gagal",
          "status": "Unprocessable Content",
          "code": 422,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "_postman_previewlanguage": "json",
          "body": "{\n  \"message\": \"The email field is required. (and 2 more errors)\",\n  \"errors\": {\n    \"email\": [\"The email field is required.\"],\n    \"password\": [\"The password field is required.\"],\n    \"device_name\": [\"The device name field is required.\"]\n  }\n}"
        },
        {
          "name": "429 Terlalu banyak percobaan",
          "status": "Too Many Requests",
          "code": 429,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "_postman_previewlanguage": "json",
          "body": "{\n  \"message\": \"Too Many Attempts.\"\n}"
        }
      ]
    },
