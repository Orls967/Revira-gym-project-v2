# Kerangka CI untuk member-app (React Native / Expo)
# Aktifkan workflow ini pada SCRUM-42 dengan menghapus ekstensi .example menjadi ci-member-app.yml
name: Member App CI

on:
  pull_request:
    branches:
      - dev
    paths:
      - 'member-app/**'
      - '.github/workflows/ci-member-app.yml'

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  lint-and-test:
    name: Lint & Test (Member App)
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: member-app
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js 24
        uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: 'npm'
          cache-dependency-path: member-app/package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Run linter
        run: npm run lint --if-present

      - name: Run tests
        run: npm test --if-present
