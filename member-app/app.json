{
  "expo": {
    "name": "Revira Gym",
    "slug": "member-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.jpg",
    "scheme": "memberapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo.jpg"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/logo.jpg",
        "monochromeImage": "./assets/images/logo.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.revira.gym",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/logo.jpg",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikasi ini membutuhkan akses galeri untuk mengunggah bukti transfer.",
          "cameraPermission": "Aplikasi ini membutuhkan akses kamera untuk mengambil foto bukti transfer."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2d533b29-2521-45be-b7aa-1dbba40436f0"
      }
    },
    "owner": "ichigo216s-team"
  }
}